<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DungeonForge</RootNamespace>
    <AssemblyName>DungeonForge</AssemblyName>
    <Product>Dungeon Forge</Product>
    <Description>Discord raid/dungeon event organizer bot</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <!-- Configuration files are copied next to the executable so that running from
       Visual Studio (F5) or `dotnet run` finds them in the output directory.
       EventConfigurations\**\*.json keeps Raids/, Dungeons/ and any deeper folders. -->
  <ItemGroup>
    <None Update="Configurations\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EventConfigurations\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
